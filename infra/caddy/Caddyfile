# Reverse proxy for the `web` service (AAO-092). Contract: docs/INFRASTRUCTURE.md §2.1.
#
#   * TLS is automatic for a real domain. SITE_ADDRESS=:80 serves plain HTTP (CI smoke tests only).
#   * Security headers and HSTS come from `web`; this file must not add its own (duplicates conflict).
#   * Caddy's reverse_proxy sets X-Forwarded-For from the real peer, replacing a client-supplied
#     value because no `trusted_proxies` are configured; `web` reads the right-most entry.
#   * Client IPs are personal data: the access log drops them.
#   * /metrics is on web's internal listener (:9100); it is not proxied and is also refused here.
{
	email {$ACME_EMAIL}
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}

	servers {
		# HTTP/3 would need UDP/443 open; the firewall policy is 22/80/443 TCP only.
		protocols h1 h2
		timeouts {
			read_body 10s
			read_header 10s
			write 30s
			idle 2m
		}
		max_header_size 16KB
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>remote_port delete
				request>headers>X-Forwarded-For delete
			}
		}
	}

	@metrics path /metrics /metrics/*
	respond @metrics 404

	reverse_proxy web:8080 {
		# Liveness, not readiness: with a single upstream a failing /readyz (say, the database) would
		# turn a degraded site into a total outage. /readyz is watched by the uptime monitor instead.
		health_uri /healthz
		health_interval 10s
		health_timeout 2s
		health_status 200

		transport http {
			dial_timeout 2s
			response_header_timeout 15s
		}
	}
}
