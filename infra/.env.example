# Copy to infra/.env (gitignored) and fill in. Read by `docker compose -f infra/compose.prod.yml`.
# Secrets are NOT here: they are files created by infra/bootstrap/gen-secrets.sh.

# Web image to run. Production deploys by digest: ghcr.io/<owner>/aao-web@sha256:...
WEB_IMAGE=

# Public domain served by Caddy (automatic TLS), e.g. example.vn. ':80' = plain HTTP, smoke tests only.
SITE_ADDRESS=
# Contact address for the Let's Encrypt account.
ACME_EMAIL=
# Staging should use the Let's Encrypt staging CA to avoid production rate limits:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Public origin for canonical/hreflang links (unset until the domain is decided, D-4).
# PUBLIC_BASE_URL=https://example.vn

# RATE_LIMIT_PAGES_PER_MINUTE=120
# RATE_LIMIT_FORMS_PER_MINUTE=10

# Interim backup (AAO-092; replaced by AAO-093)
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=7
