# Copy to .env (or run `just env`). .env is gitignored; never commit real values.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Application (see docs/OBSERVABILITY.md) ---
# APP_ENV=development            # 'production' requires DATABASE_URL_FILE and rejects inline secrets
# RUST_LOG=info
# LOG_FORMAT=text                # text (dev default) | json (production default)
# WEB_BIND=127.0.0.1:8080
# METRICS_BIND=127.0.0.1:9100    # internal only; never publish this port
# RATE_LIMIT_PAGES_PER_MINUTE=120   # per client IP, 1..=10000; assets and probes exempt
# RATE_LIMIT_FORMS_PER_MINUTE=10    # anonymous analyze / waitlist, per client IP (AAO-100)
# TRUST_FORWARDED_FOR=false         # true ONLY behind our own proxy (Caddy): uses the right-most X-Forwarded-For
# TURNSTILE_SITE_KEY=               # set both or neither; adds challenges.cloudflare.com to the CSP
# TURNSTILE_SECRET_KEY_FILE=        # production: file path, inline TURNSTILE_SECRET_KEY is rejected
# READINESS_TIMEOUT_MS=2000
# DATABASE_URL=postgres://aao:<POSTGRES_PASSWORD>@127.0.0.1:5432/aao
