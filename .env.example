# Copy to .env (or run `just env`). .env is gitignored; never commit real values.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Application (see docs/OBSERVABILITY.md) ---
# APP_ENV=development            # 'production' requires DATABASE_URL_FILE and rejects inline secrets
# RUST_LOG=info
# LOG_FORMAT=text                # text (dev default) | json (production default)
# WEB_BIND=127.0.0.1:8080
# METRICS_BIND=127.0.0.1:9100    # internal only; never publish this port
# READINESS_TIMEOUT_MS=2000
# DATABASE_URL=postgres://aao:<POSTGRES_PASSWORD>@127.0.0.1:5432/aao
